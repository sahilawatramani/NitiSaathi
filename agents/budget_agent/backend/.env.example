# ==========================
# FinAssist Backend .env
# ==========================

# -------- Core App --------
ENV=development
DATABASE_URL=sqlite:///./data/finassist.db
WEBHOOK_SECRET=finassist-dev-secret
SMS_FORWARD_SECRET=
SMS_FORWARD_DEFAULT_USER_EMAIL=
REPORT_LOOKBACK_DAYS=30
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
RATE_LIMIT_BACKEND=memory
REDIS_URL=
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
REQUIRE_HTTPS=false
AUTO_CLASSIFICATION_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite
# -------- NitiSaathi specialist microservices --------
# Use the Docker service names in compose; localhost values are for local runs.
SCHEME_AGENT_URL=http://localhost:8001
FRAUD_GUARD_URL=http://localhost:8002
NUDGE_AGENT_URL=http://localhost:8004
LITERACY_AGENT_URL=http://localhost:8100
AGENT_SERVICE_TIMEOUT_SECONDS=1.5
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------- OpenAI --------
# Required for chat + LLM fallback classification.
# App still runs with rule-based classification if empty.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Voice transcription (optional — enables /api/chat/voice)
# OPENAI_API_KEY=

# Bhashini ASR + translation (optional — Indian language support)
BHASHINI_API_KEY=

# LibreTranslate self-hosted (optional — open-source translation)
LIBRETRANSLATE_URL=

# -------- Gemini --------
# Recommended deployable alternative to OpenAI.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# -------- Ollama (Local Testing) --------
# Use for local development to avoid consuming API quotas.
# Ensure Ollama is running on localhost:11434
LLM_PROVIDER=ollama
OLLAMA_API_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=phi3

# -------- SMS Provider APIs (Optional: choose one) --------
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91
MSG91_AUTH_KEY=

# Fast2SMS
FAST2SMS_API_KEY=

# -------- Payment Gateway APIs (Optional future integrations) --------
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe
STRIPE_SECRET_KEY=

# -------- Account Aggregator / FIU (Optional future integrations) --------
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_REDIRECT_URI=
AA_WEBHOOK_SECRET=

# -------- SMTP / Email (for PDF report delivery) --------
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password   <-- use Gmail App Password, not your login password
#   SMTP_FROM_EMAIL=NitiSaathi <you@gmail.com>
#
# Other providers:
#   SendGrid: host=smtp.sendgrid.net  port=587  user=apikey  password=<SENDGRID_API_KEY>
#   Brevo:    host=smtp-relay.brevo.com  port=587  user=<login>  password=<SMTP_KEY>
#   Mailgun:  host=smtp.mailgun.org  port=587  user=postmaster@yourdomain  password=<key>
#
# Leave blank to disable email — reports will still work as browser downloads.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
